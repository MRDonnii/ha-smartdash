# Example only. Adjust paths, PHP socket and upstream address for your host.
# Protect /admin/ and /api/ with your VPN, firewall or nginx access controls.

server {
    listen 80;
    server_name _;
    root /var/www/ha-smartdash;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # Same-origin Home Assistant proxy, including WebSockets.
    location /ha/ {
        proxy_pass http://HOME_ASSISTANT_HOST:8123/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location ~ ^/(data|\.git)/ {
        deny all;
        return 404;
    }
}
