# Example only. Adjust paths, PHP socket and upstream address for your host.
# REQUIRED: Replace HOME_ASSISTANT_HOST below with the real LAN hostname or
# IP address of Home Assistant. After enabling this file, run nginx -t and
# then: sh deploy/check-install.sh http://SMARTDASH_ADDRESS
# Home Assistant must also trust the immediate Nginx proxy IP; see the
# configuration.yaml example in README.md / README.da.md.
# Protect /admin/ and /api/ with your VPN, firewall or nginx access controls.

server {
    listen 80;
    server_name _;
    root /var/www/ha-smartdash;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    # Same-origin Home Assistant proxy, including WebSockets.
    location = /ha {
        return 301 /ha/;
    }

    location /ha/ {
        proxy_pass http://HOME_ASSISTANT_HOST:8123/;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    location ~ ^/(data|\.git)/ {
        deny all;
        return 404;
    }
}
